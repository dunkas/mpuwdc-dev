rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function financeUploader() {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let assigned = user.role in ['chairman', 'admin'] ? user.role : (user.get('financeRole', '') != '' ? user.financeRole : user.role);
      return request.auth != null && request.auth.token.email_verified == true
        && user.get('disabled', false) != true && user.get('active', true) != false
        && assigned in ['chairman', 'admin', 'finance'];
    }
    match /finance-evidence/{uid}/{id} {
      allow create: if request.auth != null && request.auth.uid == uid && financeUploader()
        && firestore.exists(/databases/(default)/documents/financeEvidence/$(id))
        && firestore.get(/databases/(default)/documents/financeEvidence/$(id)).data.ownerUid == uid
        && firestore.get(/databases/(default)/documents/financeEvidence/$(id)).data.path == 'finance-evidence/' + uid + '/' + id
        && firestore.get(/databases/(default)/documents/financeEvidence/$(id)).data.status == 'Awaiting upload'
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.size == firestore.get(/databases/(default)/documents/financeEvidence/$(id)).data.size
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.contentType == firestore.get(/databases/(default)/documents/financeEvidence/$(id)).data.contentType;
      // Viewing uses the password-protected financeFile function and verifies the checksum.
      allow read, update, delete: if false;
    }
  }
}
